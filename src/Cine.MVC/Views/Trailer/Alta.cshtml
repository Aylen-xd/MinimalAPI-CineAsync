@using Cine.MVC.VModels
@model VMTrailer;
@using Cine.Core
@{
    var texto = Model.Trailer != null ? Model.Trailer.Nombre : "No se pudo dar de alta el trailer";
    ViewData["Title"] = "Alta Trailer";
}

<form asp-controller="Trailer" asp-action="Alta" method="post">
    <div><input type="hidden" asp-for="@Model.IdTrailer" /></div>
    <label asp-for="Nombre">Nombre:</label>
    <input asp-for="Nombre" type="text" class="form-control" value="" />
    <br />
    
</form>
<div class="row g-2 align-items-center">
    <div class="genero">
        <select asp-for="IdGenero" class="form-control">
            @if (Model.IdGenero == 0)
            {
                <option selected="selected" value="" disabled>Seleccione un genero</option>
                foreach (var genero in Model.listaGeneros)
                {
                    <option value="@genero.Value">@genero.Text</option>
                }
            }
        </select>
    </div>
    
    <input type="submit" value="Guardar" />

</div>
