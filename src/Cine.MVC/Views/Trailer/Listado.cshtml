@using Cine.Core
@model IEnumerable<Trailer>
@using Cine.MVC.VModels
@{

    ViewData["Title"] = "Listado Trailers";
}
<!DOCTYPE html>
<html>
    <head>
        <h1>@ViewData["Title"]</h1>

        <p>Listado:</p>
        
        @foreach (Trailer trailer in Model) 
        {
            <li>@trailer.Nombre
            <a asp-controller="Trailer" asp-action="Modificar" asp-route-id="@trailer.IdTrailer">Modificar</a>
            </li>
        }
    </head>
</html> 