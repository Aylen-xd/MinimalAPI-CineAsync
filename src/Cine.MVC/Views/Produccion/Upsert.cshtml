@using Cine.MVC.VModels
@model VMProduccion
@using Cine.Core

@{
    var texto = Model.IdProduccion == 0? "Alta Produccion" : "Modificar Produccion";
    ViewData["Title"] = texto;
}

<form asp-controller="Produccion" asp-action="Upsert" method="post">
    <div asp-validation-summary="All"></div>
    <div><input type="hidden" asp-for="@Model.IdProduccion" /></div>

    <div class="row g-2 align-items-center">
        <div class="col-auto">
            <label asp-for="Director_General" class="col-form-label">Director Produccion</label>
        </div>
        <div class="col-auto">
            <input asp-for="Director_General" class="form-control" />
        </div>
    </div>

    <div class="col-auto">
            @if (Model is null)
            {
                <button type="submit" class="btn btn-primary">@texto</button>
            }
            else
            {
                <button type="submit" class="btn btn-warning">@texto</button>
            }
        </div>
    </div>
</form>