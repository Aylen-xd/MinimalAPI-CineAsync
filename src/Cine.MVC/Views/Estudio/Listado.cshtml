@using Cine.Core
@model IEnumerable<Estudio>
@{
    ViewData[index:"Title"] = "Listado de Estudios";
}
<!DOCTYPE html>
<html>
    <head>
        <h1>@ViewData["Title"]</h1>

        <p>Listado:</p>
        
        @foreach (Estudio estudio in Model) 
        {
            <li>@estudio.Nombre
            <a asp-controller="Estudio" asp-action="Modificar" asp-route-id="@estudio.IdEstudio">Modificar</a>
            </li>
        }
        
    </head>
</html>   