@using Cine.Core
@model IEnumerable<Genero>
@{

    ViewData["Title"] = "Listado de Géneros";
}
<!DOCTYPE html>
<html>
    <head>
        <h1>@ViewData["Title"]</h1>

        <p>Listado:</p>
        
        @foreach (Genero genero in Model) 
        {
            <li>@genero.Nombre 
            <a asp-controller="Genero" asp-action="Modificar" asp-route-id="@genero.IdGenero">Modificar</a>
            </li>
        }

    </head>
</html>   